  "solution": {
    "derivation": [
      {
        "step": 1,
        "expression": "x≠-2",
        "justification": "分母不能为零"
      },
      {
        "step": 2,
        "expression": "(x-1)/(x+2)-2≥0",
        "justification": "两边同时减去 2"
      },
      {
        "step": 3,
        "expression": "(x-1-2x-4)/(x+2)≥0",
        "justification": "通分：2=2(x+2)/(x+2)"
      },
      {
        "step": 4,
        "expression": "(-x-5)/(x+2)≥0，即 (x+5)/(x+2)≤0",
        "justification": "合并分子；两边同乘 -1 时不等号方向改变"
      },
      {
        "step": 5,
        "expression": "临界点为 x=-5 与 x=-2；符号表给出 -5≤x<-2",
        "justification": "分子 x+5 在 x=-5 处变号，分母 x+2 在 x=-2 处变号；x=-2 不能取"
      },
      {
        "step": 6,
        "expression": "解集为 [-5,-2)",
        "justification": "x=-5 使分式为 0，满足 ≥；x=-2 使分母为零，排除"
      }
    ],
    "answer": "[-5,-2)",
    "conditions": ["x≠-2"]
  },
