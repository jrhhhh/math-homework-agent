  "plan": {
    "main_idea": "把 2 移到左边通分，化为一个分式与零比较，再用符号表求解。",
    "method": "移项通分与符号表",
    "prerequisites": ["分式不等式不能直接乘含未知数的分母", "符号表"],
    "steps": ["写出 x≠-2", "移项并通分", "整理分子", "求临界点并作符号表", "写出解集"]
