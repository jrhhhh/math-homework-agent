  "plan": {
    "main_idea": "已知两边及其夹角，直接用余弦定理求第三边。",
    "method": "余弦定理",
    "prerequisites": ["余弦定理", "特殊角的余弦值"],
    "steps": ["写出余弦定理", "代入 b、c、A", "计算 a²", "取正平方根"]
  },
  "solution": {
    "derivation": [
      {
        "step": 1,
        "expression": "a²=b²+c²-2bc cos A",
        "justification": "余弦定理"
      },
      {
        "step": 2,
        "expression": "a²=2²+3²-2×2×3×cos(π/3)",
        "justification": "代入 b=2、c=3、A=π/3"
      },
      {
        "step": 3,
        "expression": "cos(π/3)=1/2，所以 a²=4+9-6=7",
        "justification": "计算 2×2×3×1/2=6"
      },
      {
        "step": 4,
        "expression": "a=√7",
        "justification": "边长为正，取正的平方根"
      }
    ],
    "answer": "BC=√7",
    "conditions": ["A=π/3", "b=2，c=3"]
  },
  "verification": {
    "status": "passed",
    "checks": [
      {
        "name": "三角形不等式检查",
        "status": "passed",
        "details": "2+3=5>√7≈2.65，2+√7>3，3+√7>2，三边能组成三角形。"
      },
      {
        "name": "余弦定理反向核对",
        "status": "passed",
        "details": "cos A=(b²+c²-a²)/(2bc)=(4+9-7)/(12)=6/12=1/2，与 A=π/3 一致。"
      }
