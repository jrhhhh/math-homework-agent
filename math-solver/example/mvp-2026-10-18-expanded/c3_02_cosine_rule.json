    "variables": ["a：BC 边长", "b：AC 边长", "c：AB 边长"],
    "constraints": ["A 是边 a 所对的角"],
    "goal": "求 a=BC",
    "requested_method": null,
    "ambiguities": [],
    "assumptions": []
