  "solution": {
    "derivation": [
      {
        "step": 1,
        "expression": "x²-x-2=(x-2)(x+1)",
        "justification": "十字相乘：-2 与 1 的和为 -1，积为 -2"
      },
      {
        "step": 2,
        "expression": "(x-2)(x+1)<0",
        "justification": "代入原不等式"
      },
      {
        "step": 3,
        "expression": "两根为 x=-1 与 x=2",
        "justification": "令每个因式为零"
      },
      {
        "step": 4,
        "expression": "-1<x<2",
        "justification": "开口向上的二次函数在两根之间取负值"
      }
    ],
    "answer": "(-1,2)",
    "conditions": ["x 为实数"]
  },
