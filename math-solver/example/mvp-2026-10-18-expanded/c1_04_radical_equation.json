  "solution": {
    "derivation": [
      {
        "step": 1,
        "expression": "2x+1≥0 且 x-1≥0，所以 x≥1",
        "justification": "根号下非负；算术平方根的值非负，而它等于 x-1"
      },
      {
        "step": 2,
        "expression": "2x+1=(x-1)²",
        "justification": "在 x≥1 时两边都非负，平方是等价变形"
      },
      {
        "step": 3,
        "expression": "x²-4x=0，即 x(x-4)=0",
        "justification": "展开右边并移项"
      },
      {
        "step": 4,
        "expression": "x=0 或 x=4",
        "justification": "零乘积性质"
      },
      {
        "step": 5,
        "expression": "x=0 不满足 x≥1，舍去；x=4 保留",
        "justification": "候选根必须在定义域与右边非负条件内"
      },
      {
        "step": 6,
        "expression": "原方程的解为 x=4",
        "justification": "代回：√9=3，4-1=3，成立"
      }
    ],
    "answer": "x=4",
    "conditions": ["x≥1"]
  },
