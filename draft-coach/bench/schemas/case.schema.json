{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "draft-coach layout benchmark case",
  "type": "object",
  "required": ["case_id", "subset", "split", "difficulty", "category",
               "grade_level", "input", "expected_actions", "severity",
               "provenance"],
  "additionalProperties": false,
  "properties": {
    "case_id": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{2}$"},
    "subset": {
      "type": "string",
      "enum": ["layout_core", "evidence_discipline", "partition",
               "input_modes"]
    },
    "split": {"type": "string", "enum": ["development", "validation", "test"]},
    "difficulty": {"type": "string", "enum": ["easy", "medium", "hard"]},
    "category": {"type": "string"},
    "grade_level": {"type": "string", "enum": ["小学", "初中", "高中", "大学"]},
    "input": {
      "type": "object",
      "required": ["request", "draft", "draft_source", "has_problem_statement"],
      "additionalProperties": false,
      "properties": {
        "request": {"type": "string", "minLength": 1},
        "draft": {"type": "string"},
        "draft_source": {
          "type": "string",
          "enum": ["text_reconstruction", "image_description"]
        },
        "has_problem_statement": {"type": "boolean"},
        "audit_draft": {"type": ["string", "null"]},
        "image_note": {"type": ["string", "null"]}
      }
    },
    "expected_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["analyze", "partition", "refuse", "clarify"]}
    },
    "acceptable_refusal_reasons": {
      "type": "array",
      "items": {"type": "string", "enum": ["empty", "unreadable", "out_of_scope"]}
    },
    "refuse_reason": {
      "type": ["string", "null"],
      "enum": ["empty", "unreadable", "out_of_scope", null]
    },
    "severity": {"type": "string", "enum": ["normal", "hard"]},
    "provenance": {"type": "string"}
  }
}
