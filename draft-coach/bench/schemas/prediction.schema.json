{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "draft-coach layout benchmark prediction",
  "type": "object",
  "required": ["case_id", "action"],
  "additionalProperties": false,
  "properties": {
    "case_id": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{2}$"},
    "action": {"type": "string", "enum": ["analyze", "partition", "refuse", "clarify"]},
    "card": {"type": ["object", "null"]},
    "partition": {"type": ["object", "null"]},
    "refusal": {
      "type": ["object", "null"],
      "properties": {
        "reason": {"type": "string", "enum": ["empty", "unreadable", "out_of_scope"]},
        "message": {"type": "string"}
      }
    },
    "reply": {"type": ["string", "null"]},
    "tool_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "exit_code"],
        "properties": {
          "command": {"type": "string"},
          "exit_code": {"type": "integer"}
        }
      }
    }
  }
}
