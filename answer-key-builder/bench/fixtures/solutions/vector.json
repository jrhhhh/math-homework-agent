  "problem": {
    "statement": "已知向量 a=(1,2)，b=(2,-1)，求 a·b 及 a 与 b 的夹角。",
    "topic": "向量",
    "subtopics": ["数量积", "向量模", "夹角公式"],
    "givens": ["a=(1,2)", "b=(2,-1)"],
    "variables": ["a、b：平面向量", "θ：a 与 b 的夹角"],
    "constraints": ["θ∈[0,π]"],
    "goal": "求 a·b 及 θ",
    "requested_method": null,
    "ambiguities": [],
    "assumptions": []
  },
  "plan": {
    "main_idea": "先算数量积，再算两个模，最后用 cosθ=a·b/(|a||b|) 求夹角。",
    "method": "坐标形式的数量积与夹角公式",
    "prerequisites": ["数量积的坐标公式", "向量模的公式", "夹角公式"],
    "steps": ["计算 a·b", "计算 |a|、|b|", "代入夹角公式", "由余弦值确定角"]
  },
  "solution": {
    "derivation": [
      {
        "step": 1,
        "expression": "a·b=1×2+2×(-1)=2-2=0",
        "justification": "数量积的坐标公式 a·b=x₁x₂+y₁y₂"
      },
      {
        "step": 2,
        "expression": "|a|=√(1²+2²)=√5，|b|=√(2²+(-1)²)=√5",
        "justification": "向量模的坐标公式"
      },
      {
        "step": 3,
        "expression": "cosθ=a·b/(|a||b|)=0/(√5·√5)=0",
        "justification": "两向量夹角的余弦公式"
      },
      {
        "step": 4,
        "expression": "θ=π/2",
        "justification": "θ∈[0,π]，余弦为 0 的角只有 π/2"
      }
    ],
    "answer": "a·b=0，a 与 b 的夹角为 π/2。",
    "conditions": ["θ∈[0,π]"]
  },
  "verification": {
