  "solution": {
    "derivation": [
      {
        "step": 1,
        "expression": "设底面半径为 r，圆锥母线 l=√(r²+3)",
        "justification": "高为 √3，由勾股定理"
      },
      {
        "step": 2,
        "expression": "圆柱侧面积为 2πr√3，圆锥侧面积为 πr√(r²+3)",
        "justification": "侧面积公式"
      },
      {
        "step": 3,
        "expression": "πr√(r²+3)=2πr√3 ⇒ r²+3=12 ⇒ r=3",
        "justification": "r>0，约去 πr 后平方"
      },
      {
        "step": 4,
        "expression": "V=(1/3)πr²h=(1/3)π·9·√3=3√3π",
        "justification": "圆锥体积公式"
      }
    ],
    "answer": "B：3√3π",
    "conditions": [
      "r>0"
    ]
  },
