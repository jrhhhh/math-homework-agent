  "problem": {
    "statement": "已知圆柱和圆锥的底面半径相等，侧面积相等，且它们的高均为 √3，求圆锥的体积。",
    "topic": "立体几何",
    "subtopics": [
      "圆柱侧面积",
      "圆锥侧面积",
      "圆锥体积"
    ],
    "givens": [
      "圆柱与圆锥底面半径相等",
      "侧面积相等",
      "高均为 √3"
    ],
    "variables": [
      "r：底面半径",
      "l：圆锥母线"
    ],
    "constraints": [
      "r>0"
    ],
    "goal": "求圆锥的体积",
    "requested_method": null,
    "ambiguities": [],
    "assumptions": []
  },
  "plan": {
    "main_idea": "用侧面积相等求底面半径，再代入圆锥体积公式。",
    "method": "侧面积与体积公式",
    "prerequisites": [
      "圆柱侧面积 2πrh",
      "圆锥侧面积 πrl",
      "圆锥体积 V=πr²h/3"
    ],
    "steps": [
      "表示母线",
      "列侧面积等式",
      "解半径",
      "求体积"
