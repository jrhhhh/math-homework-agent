  "plan": {
    "main_idea": "用 a_n=a_1+(n-1)d 表示 a_4 与 a_6，先求公差 d，再写通项与求和公式。",
    "method": "基本量法",
    "prerequisites": ["等差数列通项公式", "等差数列前 n 项和公式"],
    "steps": ["设公差为 d", "由 a_4+a_6=20 求 d", "写出 a_n", "用 S_n=n(a_1+a_n)/2 求 S_n"]
  },
  "solution": {
    "derivation": [
      {
        "step": 1,
        "expression": "设公差为 d，则 a_4=2+3d，a_6=2+5d",
        "justification": "等差数列通项公式 a_n=a_1+(n-1)d"
      },
      {
        "step": 2,
        "expression": "(2+3d)+(2+5d)=20",
        "justification": "代入已知 a_4+a_6=20"
      },
      {
        "step": 3,
        "expression": "4+8d=20，所以 d=2",
        "justification": "移项并除以 8"
      },
      {
        "step": 4,
        "expression": "a_n=2+(n-1)·2=2n",
        "justification": "代入通项公式并化简"
      },
      {
        "step": 5,
        "expression": "S_n=n(a_1+a_n)/2=n(2+2n)/2=n(n+1)",
        "justification": "等差数列前 n 项和公式，或 S_n=na_1+n(n-1)d/2"
      }
    ],
    "answer": "a_n=2n，S_n=n(n+1)=n²+n。",
    "conditions": ["n 为正整数"]
  },
