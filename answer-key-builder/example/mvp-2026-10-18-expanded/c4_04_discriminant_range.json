  "solution": {
    "derivation": [
      {
        "step": 1,
        "expression": "Δ=(-2a)²-4·1·(a+2)",
        "justification": "一元二次方程 ax²+bx+c=0 的判别式 Δ=b²-4ac；此处二次项系数为 1"
      },
      {
        "step": 2,
        "expression": "Δ=4a²-4a-8=4(a²-a-2)",
        "justification": "展开并提取公因式 4"
      },
      {
        "step": 3,
        "expression": "a²-a-2=(a-2)(a+1)",
        "justification": "因式分解"
      },
      {
        "step": 4,
        "expression": "4(a-2)(a+1)>0，即 (a-2)(a+1)>0",
        "justification": "两个不等实根要求 Δ>0；两边同除以正数 4"
      },
      {
        "step": 5,
        "expression": "a<-1 或 a>2",
        "justification": "开口向上，大于零取两根之外"
      }
    ],
    "answer": "a∈(-∞,-1)∪(2,+∞)",
    "conditions": ["方程有两个不等实根"]
  },
