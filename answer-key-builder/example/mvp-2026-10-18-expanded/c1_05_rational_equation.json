  "solution": {
    "derivation": [
      {
        "step": 1,
        "expression": "x²-4=(x-2)(x+2)，且 x≠2、x≠-2",
        "justification": "平方差公式；分母不能为零"
      },
      {
        "step": 2,
        "expression": "x(x+2)+(x-2)=8",
        "justification": "两边同乘 (x-2)(x+2)；由第 1 步该式不为零"
      },
      {
        "step": 3,
        "expression": "x²+3x-10=0",
        "justification": "展开并合并同类项"
      },
      {
        "step": 4,
        "expression": "(x+5)(x-2)=0，所以 x=-5 或 x=2",
        "justification": "因式分解"
      },
      {
        "step": 5,
        "expression": "x=2 使分母为零，舍去；x=-5 保留",
        "justification": "候选根必须在定义域内"
      },
      {
        "step": 6,
        "expression": "原方程的解为 x=-5",
        "justification": "代回：左边 (-5)/(-7)+1/(-3)=5/7-1/3=8/21，右边 8/21"
      }
    ],
    "answer": "x=-5",
    "conditions": ["x≠2 且 x≠-2"]
  },
